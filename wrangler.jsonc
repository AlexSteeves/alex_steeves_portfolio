 
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "alex-steeves-portfolio", // Name of your project
	"main": "./server/src/index.ts", // Path to worker
	// No workers.dev mirror: it serves the same API but bypasses the rate limit
	// and any other rule set on alexsteeves.dev.
	"workers_dev": false,
	"compatibility_date": "2025-05-25",
	"assets": {
		"directory": "./client/dist", // Path to client build folder
		"not_found_handling": "single-page-application" // Handle SPA routing
	},
	"compatibility_flags": ["nodejs_compat"], // Enable node for Vite path features
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio",
			"database_id": "22709cd4-29c2-4624-b493-579cd354f028",
			"migrations_dir": "./server/migrations"
		}
	],
	"dev": {
		"port": 3000
	}
}