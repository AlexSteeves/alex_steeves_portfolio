{
  "name": "alex-steeves-portfolio",
  "version": "0.5.1",
  "description": "Personal portfolio and full-stack tools built with React, Hono, and Cloudflare Workers.",
  "author": "Alex Steeves",
  "license": "MIT",
  "homepage": "https://github.com/AlexSteeves/alex_steeves_portfolio",
  "packageManager": "bun@1.2.4",
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=client",
    "dev:server": "turbo dev --filter=server",
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "postinstall": "turbo build --filter=shared --filter=server",
    "deploy": "turbo build && wrangler deploy --minify"
  },
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "monorepo",
    "turbo"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260219.0",
    "bun-types": "latest",
    "turbo": "^2.6.3",
    "wrangler": "^4.67.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "react-select": "^5.10.2"
  }
}
